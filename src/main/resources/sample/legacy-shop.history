import com.acme.shop.model.Order;

/**
 * Payment by bank slip: the slip is issued now and paid later.
 */
public class BankSlipPaymentService implements PaymentService {

    public boolean pay(Order order) {
        System.out.println("Bank slip issued for order " + order.getNumber() + ": " + order.getTotal());
        return true;
    }
}
