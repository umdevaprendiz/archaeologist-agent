add src/main/java/com/acme/shop/TaxCalculator.java
<<<
package com.acme.shop;

/**
 * Sales tax by state and amount, following the state tax table.
 */
public class TaxCalculator {

    public static double calculate(String state, double amount) {
        if (state == null || amount <= 0) {
            return 0;
        }
        double rate;
        if (state.equals("SP")) {
            rate = amount > 1000 ? 0.18 : 0.12;
        } else if (state.equals("RJ")) {
            rate = amount > 1000 ? 0.20 : 0.13;
        } else if (state.equals("MG")) {
            if (amount > 2000) {
                rate = 0.18;
            } else if (amount > 1000) {
                rate = 0.15;
            } else {
                rate = 0.12;
            }
        } else if (state.equals("RS") || state.equals("SC") || state.equals("PR")) {
            rate = amount > 1500 ? 0.17 : 0.12;
        } else if (state.equals("BA") || state.equals("PE") || state.equals("CE")) {
            rate = 0.18;
        } else if (state.equals("AM")) {
            // Free trade zone
            rate = amount > 500 ? 0.07 : 0.0;
        } else if (state.equals("DF") || state.equals("GO")) {
            rate = 0.12;
        } else {
            rate = 0.17;
        }
        double tax = amount * rate;
        if (tax > 0 && tax < 1) {
            tax = 1;
        }
        return Math.round(tax * 100) / 100.0;
    }

    public static boolean exempt(String productCode, String state) {
        if (productCode == null) {
            return false;
        }
        if (productCode.startsWith("BOOK")) {
            return true;
        }
        if (productCode.startsWith("FOOD") && !state.equals("AM")) {
            return true;
        }
        if (productCode.startsWith("MED")) {
            return state.equals("SP") || state.equals("RJ") || state.equals("MG");
        }
        return false;
    }
}
