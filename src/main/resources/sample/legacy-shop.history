package com.acme.shop;

import static org.junit.Assert.assertEquals;

import org.junit.Test;

public class TaxCalculatorTest {

    @Test
    public void noTaxWithoutState() {
        assertEquals(0.0, TaxCalculator.calculate(null, 100), 0.001);
    }

    @Test
    public void saoPauloBelowTheLimit() {
        assertEquals(12.0, TaxCalculator.calculate("SP", 100), 0.001);
    }

    @Test
    public void minimumTaxIsOne() {
        assertEquals(1.0, TaxCalculator.calculate("DF", 5), 0.001);
    }
}
