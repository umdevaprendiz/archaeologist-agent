===
    private int quantity;
    private double weight;
>>>

replace src/main/java/com/acme/shop/model/OrderItem.java
<<<
    public void setQuantity(int quantity) {
        this.quantity = quantity;
    }
}
===
    public void setQuantity(int quantity) {
        this.quantity = quantity;
    }

    public double getWeight() {
        return weight;
    }

    public void setWeight(double weight) {
        this.weight = weight;
    }
}
>>>

replace src/main/java/com/acme/shop/OrderManager.java
<<<
        total = total + TaxCalculator.calculate(order.getCustomer().getState(), total);
        return total;
    }
===
        total = total + TaxCalculator.calculate(order.getCustomer().getState(), total);
        total = total + shippingCost(order);
        return total;
    }

    public double shippingCost(Order order) {
        double weight = 0;
        for (int i = 0; i < order.getItems().size(); i++) {
            OrderItem item = (OrderItem) order.getItems().get(i);
            weight = weight + item.getWeight() * item.getQuantity();
        }
        String state = order.getCustomer().getState();
        double cost;
        if (state.equals("SP") || state.equals("RJ") || state.equals("MG")) {
            cost = 15;
        } else if (state.equals("RS") || state.equals("SC") || state.equals("PR")) {
            cost = 20;
        } else {
            cost = 30;
        }
        if (weight > 10) {
            cost = cost + (weight - 10) * 2;
        }
        if ("FRETE".equals(order.getCoupon())) {
            cost = 0;
        }
        return cost;
    }
>>>

