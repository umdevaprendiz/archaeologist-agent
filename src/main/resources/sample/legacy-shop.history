    private void logStatusChange(Order order, String change) {
        Connection connection = null;
        PreparedStatement statement = null;
        try {
            connection = ConnectionFactory.getConnection();
            statement = connection.prepareStatement("INSERT INTO order_history (number, change, changed_at)"
                    + " VALUES (?, ?, ?)");
            statement.setString(1, order.getNumber());
            statement.setString(2, change);
            statement.setTimestamp(3, new Timestamp(new Date().getTime()));
            statement.executeUpdate();
        } catch (SQLException e) {
            System.out.println("Error logging status of order " + order.getNumber() + ": " + e.getMessage());
        } finally {
            close(statement, connection);
        }
    }

    private void close(PreparedStatement statement, Connection connection) {
