add src/main/java/com/acme/shop/OrderManager.java
<<<
package com.acme.shop;

import com.acme.shop.db.ConnectionFactory;
import com.acme.shop.model.Customer;
import com.acme.shop.model.Order;
import com.acme.shop.model.OrderItem;
import com.acme.shop.util.DateHelper;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Timestamp;
import java.util.Date;
import java.util.Iterator;
import java.util.List;
import java.util.Random;
import java.util.Vector;

/**
 * Manages the orders of the shop: creation, totals, persistence and status changes.
 */
public class OrderManager {

    private static OrderManager instance;

    private Random random = new Random();

    private OrderManager() {
    }

    public static synchronized OrderManager getInstance() {
        if (instance == null) {
            instance = new OrderManager();
        }
        return instance;
    }

    public Order createOrder(Customer customer, List items) {
        if (customer == null) {
            throw new IllegalArgumentException(Messages.CUSTOMER_REQUIRED);
        }
        if (items == null || items.size() == 0) {
            throw new IllegalArgumentException(Messages.ORDER_EMPTY);
        }
        Order order = new Order();
        order.setNumber(newOrderNumber());
        order.setCustomer(customer);
        order.setCreatedAt(new Date());
        order.setStatus(Order.STATUS_NEW);
        Vector lines = new Vector();
        Iterator it = items.iterator();
        while (it.hasNext()) {
            OrderItem item = (OrderItem) it.next();
            lines.add(item);
        }
        order.setItems(lines);
        order.setTotal(calculateTotal(order));
        save(order);
        return order;
    }

    public double calculateTotal(Order order) {
        double total = 0;
        for (int i = 0; i < order.getItems().size(); i++) {
            OrderItem item = (OrderItem) order.getItems().get(i);
            total = total + item.getPrice() * item.getQuantity();
        }
        if (total > 500) {
            total = total - total * 0.1;
        }
        return total;
    }

    private String newOrderNumber() {
        return DateHelper.format(new Date(), "yyyyMMdd") + "-" + random.nextInt(10000);
    }

    public void save(Order order) {
        Connection connection = null;
        PreparedStatement statement = null;
        try {
            connection = ConnectionFactory.getConnection();
            statement = connection.prepareStatement("INSERT INTO orders (number, customer_id, created_at, status, total)"
                    + " VALUES (?, ?, ?, ?, ?)");
            statement.setString(1, order.getNumber());
            statement.setLong(2, order.getCustomer().getId());
            statement.setTimestamp(3, new Timestamp(order.getCreatedAt().getTime()));
            statement.setInt(4, order.getStatus());
            statement.setDouble(5, order.getTotal());
            statement.executeUpdate();
        } catch (SQLException e) {
            System.out.println("Error saving order " + order.getNumber() + ": " + e.getMessage());
        } finally {
            close(statement, connection);
        }
    }

    public Order findOrder(String number) {
        Connection connection = null;
        PreparedStatement statement = null;
        try {
            connection = ConnectionFactory.getConnection();
            statement = connection.prepareStatement("SELECT id, status, total, created_at FROM orders WHERE number = ?");
            statement.setString(1, number);
            ResultSet rs = statement.executeQuery();
            if (rs.next()) {
                Order order = new Order();
                order.setId(new Long(rs.getLong(1)));
                order.setNumber(number);
                order.setStatus(rs.getInt(2));
                order.setTotal(rs.getDouble(3));
                order.setCreatedAt(rs.getTimestamp(4));
                return order;
            }
            return null;
        } catch (SQLException e) {
            System.out.println("Error reading order " + number + ": " + e.getMessage());
            return null;
        } finally {
            close(statement, connection);
        }
    }

    public void cancel(Order order) {
        if (order.getStatus() == Order.STATUS_NEW) {
            order.setStatus(Order.STATUS_CANCELLED);
            updateStatus(order);
        }
    }

    private void updateStatus(Order order) {
        Connection connection = null;
        PreparedStatement statement = null;
        try {
            connection = ConnectionFactory.getConnection();
            statement = connection.prepareStatement("UPDATE orders SET status = ? WHERE number = ?");
            statement.setInt(1, order.getStatus());
            statement.setString(2, order.getNumber());
            statement.executeUpdate();
        } catch (SQLException e) {
            System.out.println("Error updating order " + order.getNumber() + ": " + e.getMessage());
        } finally {
            close(statement, connection);
        }
    }

    private void close(PreparedStatement statement, Connection connection) {
        try {
            if (statement != null) {
                statement.close();
            }
            if (connection != null) {
                connection.close();
            }
        } catch (SQLException e) {
            // ignore
        }
    }
}
>>>

