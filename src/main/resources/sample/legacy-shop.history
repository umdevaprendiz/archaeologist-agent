add src/main/java/com/acme/shop/ReportGenerator.java
<<<
package com.acme.shop;

import com.acme.shop.model.Order;
import com.acme.shop.util.DateHelper;

import java.io.FileWriter;
import java.io.IOException;
import java.lang.reflect.Method;
import java.util.Date;
import java.util.List;

/**
 * Writes the sales reports to text files.
 */
public class ReportGenerator {

    public void salesReport(Date from, Date to, String fileName) throws IOException {
        List orders = OrderManager.getInstance().findOrdersBetween(from, to);
        FileWriter writer = new FileWriter(fileName);
        try {
            writer.write("Sales report " + DateHelper.format(from, "dd/MM/yyyy") + " - "
                    + DateHelper.format(to, "dd/MM/yyyy") + "\n");
            double total = 0;
            for (int i = 0; i < orders.size(); i++) {
                Order order = (Order) orders.get(i);
                writer.write(order.getNumber() + ";" + value(order, "getTotal") + "\n");
                total = total + order.getTotal();
            }
            writer.write("Total: " + total + "\n");
        } finally {
            writer.close();
        }
    }

    /** Reads a property of the order by name, so new columns need no code change. */
    private String value(Order order, String getter) {
        try {
            Method method = order.getClass().getMethod(getter, new Class[0]);
            return String.valueOf(method.invoke(order, new Object[0]));
        } catch (Exception e) {
            return "";
        }
    }
}
