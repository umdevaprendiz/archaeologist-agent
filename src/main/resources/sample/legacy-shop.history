commit 1450 diego
Add CSV export to the sales report

replace src/main/java/com/acme/shop/ReportGenerator.java
<<<
    /** Reads a property of the order by name, so new columns need no code change. */
===
    public void csvReport(Date from, Date to, String fileName) throws IOException {
        List orders = OrderManager.getInstance().findOrdersBetween(from, to);
        FileWriter writer = new FileWriter(fileName);
        try {
            writer.write("number;status;total\n");
            for (int i = 0; i < orders.size(); i++) {
                Order order = (Order) orders.get(i);
                writer.write(order.getNumber() + ";" + value(order, "getStatus") + ";" + value(order, "getTotal") + "\n");
            }
        } finally {
            writer.close();
        }
    }

    /** Reads a property of the order by name, so new columns need no code change. */
>>>

